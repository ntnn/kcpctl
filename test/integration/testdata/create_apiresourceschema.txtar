# dry run prints the object without creating it
exec kcpctl create apirs --crd crd.yaml --dry-run=client -o yaml
stdout 'kind: APIResourceSchema'
stdout 'name: v[0-9a-f]{8}\.widgets\.example\.io'
exec kcpctl get apiresourceschemas
! stdout widgets

# create with the stable hash prefix
exec kcpctl create apiresourceschema --crd crd.yaml
stdout 'apiresourceschema.apis.kcp.io/v[0-9a-f]{8}\.widgets\.example\.io created'
exec kcpctl get apiresourceschemas
stdout 'widgets\.example\.io'

# same CRD maps to the same immutable schema
! exec kcpctl create apirs --crd crd.yaml
stderr 'already exists'

# explicit prefix
exec kcpctl create apirs --crd crd.yaml --prefix today
stdout 'apiresourceschema.apis.kcp.io/today.widgets.example.io created'

-- crd.yaml --
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: widgets.example.io
spec:
  group: example.io
  names:
    plural: widgets
    singular: widget
    kind: Widget
    listKind: WidgetList
  scope: Namespaced
  versions:
  - name: v1
    served: true
    storage: true
    schema:
      openAPIV3Schema:
        type: object
