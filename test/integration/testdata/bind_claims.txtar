# provider workspace exports the widgets API
exec kcpctl create workspace provider
exec kcpctl -W :root:provider create apirs --crd crd.yaml --prefix today
exec kcpctl -W :root:provider apply -f apiexport.yaml
stdout 'apiexport.apis.kcp.io/example.io created'

# consumer workspace binds the export, accepting its claims
exec kcpctl create workspace consumer
exec kcpctl -W :root:consumer bind apiexport root:provider:example.io --accept-all-permission-claims
stdout 'created and bound'

# bound API is served in the consumer workspace
exec kcpctl -W :root:consumer create -f widget.yaml
exec kcpctl -W :root:consumer get widgets
stdout smoke

# accepted claim is on the binding
exec kcpctl -W :root:consumer claims get apibinding example.io
stdout 'configmaps\s+\*\s+Accepted'

# reject flips the claim state
exec kcpctl -W :root:consumer claims reject example.io --resource configmaps
stdout 'on APIBinding "example.io" is rejected'
exec kcpctl -W :root:consumer claims get apibinding example.io
stdout 'configmaps\s+\*\s+Rejected'

-- crd.yaml --
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: widgets.example.io
spec:
  group: example.io
  names:
    plural: widgets
    singular: widget
    kind: Widget
    listKind: WidgetList
  scope: Cluster
  versions:
  - name: v1
    served: true
    storage: true
    schema:
      openAPIV3Schema:
        type: object

-- apiexport.yaml --
apiVersion: apis.kcp.io/v1alpha2
kind: APIExport
metadata:
  name: example.io
spec:
  resources:
  - group: example.io
    name: widgets
    schema: today.widgets.example.io
    storage:
      crd: {}
  permissionClaims:
  - group: ""
    resource: configmaps
    verbs: ["*"]

-- widget.yaml --
apiVersion: example.io/v1
kind: Widget
metadata:
  name: smoke
